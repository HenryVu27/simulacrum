#!/usr/bin/env bash
# Refuses a push whose commits (contents, messages, author and committer) contain a private string. The strings
# are listed in .private-patterns at the top of the repository, one extended regular expression per line, which
# git ignores: the repository is public, so the list must stay out of it. Install once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
root=$(git rev-parse --show-toplevel)
if [ ! -f "$root/.private-patterns" ]; then
  echo "pre-push: no .private-patterns here, nothing checked" >&2
  exit 0
fi
pat=$(grep -vE '^[[:space:]]*(#|$)' "$root/.private-patterns" | paste -sd'|' -)
[ -n "$pat" ] || exit 0
zero=0000000000000000000000000000000000000000
bad=0
while read -r _ lsha _ rsha; do
  [ "$lsha" = "$zero" ] && continue  # deleting a branch
  if [ "$rsha" = "$zero" ]; then range=$lsha; else range=$rsha..$lsha; fi
  hits=$(git log -p --format='%an <%ae>%n%cn <%ce>%n%B' "$range" | grep -nE -- "$pat" | head -5 || true)
  if [ -n "$hits" ]; then
    echo "pre-push: refused, private strings in $range:" >&2
    echo "$hits" | cut -c1-160 >&2
    bad=1
  fi
done
exit $bad
